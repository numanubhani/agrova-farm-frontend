# Copy this to `.env.production` before running `npm run build` for
# deployment, and fill in your real backend subdomain.
#
#   cp .env.production.example .env.production
#
# Vite bakes this value into the built JS at build time — there's no
# runtime env var on shared hosting, so you must rebuild if it changes.

VITE_API_BASE_URL=https://api.yourdomain.com/api
