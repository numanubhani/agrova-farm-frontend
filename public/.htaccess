# Apache config for a React SPA on shared hosting / cPanel. Vite copies
# everything in /public into the build output root, so this ends up at
# dist/.htaccess — upload it alongside the rest of dist/* to the
# subdomain's document root.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Let real files/folders (JS, CSS, images, etc.) through as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else (e.g. /bills, /delivery) falls back to index.html
  # so React Router can handle it client-side
  RewriteRule ^ index.html [L]
</IfModule>

# Cache hashed build assets aggressively; never cache index.html itself
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>
<FilesMatch "^index\.html$">
  Header set Cache-Control "no-cache"
</FilesMatch>
